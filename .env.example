# =============================================================================
# Game QA Testcase — optional environment overrides
# Copy to .env only if you need to override a default:  cp .env.example .env
# =============================================================================
# The pipeline runs out-of-the-box WITHOUT this file:
#   - OAuth paths default to ./credentials/client_secret.json + oauth_token.json
#   - Spreadsheet IDs are passed as CLI arguments by the orchestrator
#
# These keys are read straight from the *process environment* (scripts call
# process.env.*). There is no auto-.env loader by design (no dotenv dependency),
# so to use a non-default value, export it in the shell / Claude Code session
# that runs the pipeline, e.g.:
#   export GOOGLE_OAUTH_PATH=/abs/path/client_secret.json
# =============================================================================

# Path to the Google OAuth client-secret JSON
# (default: ./credentials/client_secret.json)
GOOGLE_OAUTH_PATH=./credentials/client_secret.json

# Path to the cached OAuth token — auto-created on first authorization
# (default: ./credentials/oauth_token.json)
GOOGLE_TOKEN_PATH=./credentials/oauth_token.json

# Default spreadsheet ID for dashboard / metrics scripts when no CLI arg is given
# URL: https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit  (optional)
SPREADSHEET_ID=

# Slack bot token — enables optional QA / TC Slack notifications
# Leave blank to disable Slack entirely (optional)
SLACK_BOT_TOKEN=
