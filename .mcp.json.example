{
  "_comment": "Copy the needed servers into ~/.claude/.mcp.json (or register via 'claude mcp add'). Atlassian/Confluence access is usually provided by Claude Code's built-in Atlassian connector instead of this file — see docs/PREREQUISITES.md.",
  "mcpServers": {
    "google-sheets": {
      "command": "node",
      "args": ["PATH_TO_NODE_MODULES/mcp-google-sheets/dist/index.js"],
      "env": {
        "GOOGLE_SHEETS_CLIENT_ID": "YOUR_GOOGLE_CLIENT_ID",
        "GOOGLE_SHEETS_CLIENT_SECRET": "YOUR_GOOGLE_CLIENT_SECRET",
        "TOKEN_PATH": "PATH_TO_HOME/.mcp-google-sheets-token.json"
      }
    },
    "claude_ai_Atlassian": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.atlassian.com/v1/sse"],
      "env": {
        "ATLASSIAN_SITE_URL": "https://YOUR_SITE.atlassian.net"
      }
    }
  }
}
